# Database
DATABASE_URL=postgresql://localhost:5432/bidding

# JWT
JWT_SECRET=your_strong_secret_key_here_change_in_production
JWT_EXPIRES_IN=24h

# Server
PORT=3001
NODE_ENV=development

# Upload
UPLOAD_DIR=./uploads

# CORS Allowed Origins (comma-separated, production only)
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# Log Level (ERROR, WARN, INFO, DEBUG)
LOG_LEVEL=INFO
